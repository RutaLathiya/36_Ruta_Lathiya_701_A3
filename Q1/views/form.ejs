<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>User Registration</title>

    <link rel="stylesheet"
        href="/style.css">

</head>

<body>

<div class="container">

    <h1>User Registration Form</h1>

    <form
        action="/register"
        method="POST"
        enctype="multipart/form-data"
    >

        <!-- Username -->

        <div class="form-group">

            <label>Username:</label>

            <input
                type="text"
                name="username"
                value="<%= values.username || '' %>"
            >

            <% errors.forEach(error => { %>

                <% if (error.path === "username") { %>

                    <p class="error">
                        <%= error.msg %>
                    </p>

                <% } %>

            <% }) %>

        </div>


        <!-- Password -->

        <div class="form-group">

            <label>Password:</label>

            <input
                type="password"
                name="password"
            >

            <% errors.forEach(error => { %>

                <% if (error.path === "password") { %>

                    <p class="error">
                        <%= error.msg %>
                    </p>

                <% } %>

            <% }) %>

        </div>


        <!-- Confirm Password -->

        <div class="form-group">

            <label>Confirm Password:</label>

            <input
                type="password"
                name="confirmPassword"
            >

            <% errors.forEach(error => { %>

                <% if (error.path === "confirmPassword") { %>

                    <p class="error">
                        <%= error.msg %>
                    </p>

                <% } %>

            <% }) %>

        </div>


        <!-- Email -->

        <div class="form-group">

            <label>Email:</label>

            <input
                type="text"
                name="email"
                value="<%= values.email || '' %>"
            >

            <% errors.forEach(error => { %>

                <% if (error.path === "email") { %>

                    <p class="error">
                        <%= error.msg %>
                    </p>

                <% } %>

            <% }) %>

        </div>


        <!-- Gender -->

        <div class="form-group">

            <label>Gender:</label>

            <div>

                <label class="inline">

                    <input
                        type="radio"
                        name="gender"
                        value="Male"
                        <%= values.gender === "Male"
                            ? "checked"
                            : "" %>
                    >

                    Male

                </label>


                <label class="inline">

                    <input
                        type="radio"
                        name="gender"
                        value="Female"
                        <%= values.gender === "Female"
                            ? "checked"
                            : "" %>
                    >

                    Female

                </label>


                <label class="inline">

                    <input
                        type="radio"
                        name="gender"
                        value="Other"
                        <%= values.gender === "Other"
                            ? "checked"
                            : "" %>
                    >

                    Other

                </label>

            </div>


            <% errors.forEach(error => { %>

                <% if (error.path === "gender") { %>

                    <p class="error">
                        <%= error.msg %>
                    </p>

                <% } %>

            <% }) %>

        </div>


        <!-- Hobbies -->

        <div class="form-group">

            <label>Hobbies:</label>

            <div>

                <label class="inline">

                    <input
                        type="checkbox"
                        name="hobbies"
                        value="Reading"
                        <%= hobbies.includes("Reading")
                            ? "checked"
                            : "" %>
                    >

                    Reading

                </label>


                <label class="inline">

                    <input
                        type="checkbox"
                        name="hobbies"
                        value="Sports"
                        <%= hobbies.includes("Sports")
                            ? "checked"
                            : "" %>
                    >

                    Sports

                </label>


                <label class="inline">

                    <input
                        type="checkbox"
                        name="hobbies"
                        value="Music"
                        <%= hobbies.includes("Music")
                            ? "checked"
                            : "" %>
                    >

                    Music

                </label>


                <label class="inline">

                    <input
                        type="checkbox"
                        name="hobbies"
                        value="Travel"
                        <%= hobbies.includes("Travel")
                            ? "checked"
                            : "" %>
                    >

                    Travel

                </label>

            </div>


            <% errors.forEach(error => { %>

                <% if (error.path === "hobbies") { %>

                    <p class="error">
                        <%= error.msg %>
                    </p>

                <% } %>

            <% }) %>

        </div>


        <!-- Profile Picture -->

        <div class="form-group">

            <label>Profile Picture:</label>

            <input
                type="file"
                name="profilePic"
                accept="image/*"
            >

        </div>


        <!-- Other Pictures -->

        <div class="form-group">

            <label>Other Pictures:</label>

            <input
                type="file"
                name="otherPics"
                accept="image/*"
                multiple
            >

            <small>
                You can upload maximum 5 images.
            </small>

        </div>


        <!-- File Errors -->

        <% errors.forEach(error => { %>

            <% if (error.path === "files") { %>

                <p class="error">
                    <%= error.msg %>
                </p>

            <% } %>

        <% }) %>


        <button type="submit">
            Register
        </button>

    </form>

</div>

</body>

</html>